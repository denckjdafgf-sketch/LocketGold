#!name=Locket Custom Edition
#!desc=Crack | Tùy chỉnh Video & Caption cá nhân.

[General]

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com

[Script]
# 1. Tùy chỉnh Feature, Video 45s & Caption cá nhân
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/denckjdafgf-sketch/LocketGold/refs/heads/main/TuyChinhTest.js, requires-body=true, max-size=524288, timeout=60

# 2. Xóa ETag Header chống dính Cache
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/denckjdafgf-sketch/LocketGold/refs/heads/main/deleteHeader.js, timeout=60

# 3. Kích hoạt Gold & Ngày 10/09/2009
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/denckjdafgf-sketch/LocketGold/refs/heads/main/upLocketGold.js, requires-body=true, max-size=-1, timeout=60
